DATABASE_URL=postgresql://bookstore:change-me@localhost:5432/bookstore
DB_POOL_MAX=10
APP_ORIGIN=http://localhost:3000
TRUST_PROXY_HEADERS=false
INTEGRATION_ENCRYPTION_KEY=

# ── Redis cache (multi-instance shared cache) ────────────────────────────────
# Redis URL for shared caching across PM2 cluster instances.
# Falls back to in-process cache when unset (single-instance deployments).
# REDIS_URL=redis://localhost:6379

# ── Semantic search (pgvector + Gemini embeddings) ──────────────────────────
# Key from https://aistudio.google.com (free tier). Unset → semantic tier and
# embedding backfill silently no-op; search falls back to trigram behavior.
GEMINI_API_KEY=

# ── AI Concierge (Thư Thủ AI, shop chat) ─────────────────────────────────────
# Key from https://platform.deepseek.com. Unset → /api/concierge returns 503
# and the chat UI falls back to canned demo replies.
DEEPSEEK_API_KEY=
# Optional override; defaults to deepseek-chat.
# DEEPSEEK_MODEL=deepseek-chat
# Global daily turn cap across ALL visitors (credit-burn ceiling against
# distributed spam; per-IP limit stays 20/min). Exceeding it returns 503
# until the 24h window resets.
# DEEPSEEK_DAILY_LIMIT=2000
# Optional API base override (OpenAI-compatible proxies). Defaults to
# https://api.deepseek.com — only set for local mock/gateway testing.
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Multi-instance scaling (Group 2) ────────────────────────────────────────
# Read replica for hot read paths (storefront catalog, dashboard, analytics,
# browse/search). Unset → those reads fall back to the primary automatically.
# READ_REPLICA_URL=postgresql://bookstore:change-me@replica-host:5432/bookstore
# DB_POOL_MAX_READ=10

# In-process job scheduler (instrumentation.ts). Default: runs only on the first
# PM2 cluster worker (NODE_APP_INSTANCE=0); single-node deploys always run it.
# "false" = never schedule here (drive /api/jobs from external cron instead).
# JOB_SCHEDULER_ENABLED=

# Local/CI seed only. Never seed demo users into production.
SEED_USER_PASSWORD=

# Business timezone for reporting windows (dashboard/analytics day/month bounds).
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Set true ONLY behind a reverse proxy that overwrites X-Forwarded-For
# (nginx/Cloudflare/ALB). See docs/OPERATIONS.md "Reverse-proxy contract".

# ── VNPay sandbox checkout ──────────────────────────────────────────────────
# Register at https://sandbox.vnpayment.vn/devreg. Unset → storefront checkout
# rejects paymentMethod=VNPAY; COD flow unaffected.
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_RETURN_URL=http://localhost:3000/api/payments/vnpay/return
VNP_IPN_URL=http://localhost:3000/api/payments/vnpay/ipn

# ── SMTP mail (password reset) ───────────────────────────────────────────────
# Unset → password-reset links are logged server-side instead of emailed
# (dev fallback). Production MUST configure these.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Melio Bookstore <no-reply@melio.vn>"

# ── Error tracking ───────────────────────────────────────────────────────────
# Either, both or neither. Unset → structured JSON logs only (stdout/PM2).
# SENTRY_DSN: minimal Envelope API sender (no @sentry/node dependency).
# ERROR_WEBHOOK_URL: Slack/Discord/Telegram-style incoming webhook POST.
# Both are fire-and-forget, deduped (5 min per fingerprint) and throttled
# (30 events/min) so a crash loop can't burn quota or flood a channel.
SENTRY_DSN=
ERROR_WEBHOOK_URL=

# ── Retention pruning (nightly jobs) ─────────────────────────────────────────
# AuditLog rows older than the window are deleted; WebhookDelivery keeps
# undelivered rows (retry queue) and prunes DELIVERED ones only.
AUDIT_LOG_RETENTION_DAYS=90
WEBHOOK_DELIVERY_RETENTION_DAYS=30
# InventoryMovement partitions older than this many months are DETACHED
# (data preserved as standalone tables — re-attachable), not dropped.
INVENTORY_PARTITION_RETENTION_MONTHS=18
