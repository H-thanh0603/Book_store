DATABASE_URL=postgresql://bookstore:change-me@localhost:5432/bookstore
DB_POOL_MAX=10
APP_ORIGIN=http://localhost:3000
# true CHỈ khi app đứng sau reverse-proxy (nginx/Cloudflare/ALB) overwrite
# X-Forwarded-For — khi đó rate limiter thấy IP thật từng client. false khi
# app exposed trực tiếp: mọi client chung 1 bucket/namespace (an toàn, thô).
# Xem docs/OPERATIONS.md "Reverse-proxy contract".
TRUST_PROXY_HEADERS=false
INTEGRATION_ENCRYPTION_KEY=
# Per-session CSRF token HMAC secret. Optional — falls back to
# INTEGRATION_ENCRYPTION_KEY; set explicitly in production for separation.
#CSRF_SECRET=

# ── Redis cache (multi-instance shared cache) ────────────────────────────────
# Redis URL for shared caching across PM2 cluster instances.
# Falls back to in-process cache when unset (single-instance deployments).
# REDIS_URL=redis://localhost:6379

# ── Semantic search (pgvector + Gemini embeddings) ──────────────────────────
# Key from https://aistudio.google.com (free tier). Unset → semantic tier and
# embedding backfill silently no-op; search falls back to trigram behavior.
GEMINI_API_KEY=

# ── AI Concierge (Thư Thủ AI, shop chat) + Merchant Agent ───────────────────
# Canonical vars are LLM_*; the historical DEEPSEEK_* names still work as
# fallback. Unset key → /api/concierge + /api/merchant return 503 and the
# chat UI falls back to canned demo replies.
# DeepSeek (default provider): key from https://platform.deepseek.com.
# LLM_API_KEY=
# Optional overrides; defaults shown.
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# OpenRouter example (key from https://openrouter.ai/keys):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=nex-agi/nex-n2.5-pro:free
# TokenRouter example:
# LLM_BASE_URL=https://api.tokenrouter.com/v1
# LLM_API_KEY=sk-TK...
# LLM_MODEL=z-ai/glm-5.3-free
DEEPSEEK_API_KEY=
# Optional override; defaults to deepseek-chat.
# DEEPSEEK_MODEL=deepseek-chat
# HMAC secret signing the concierge's agent_cart checkout handoff link
# (>= 16 chars). Unset → the checkout card ships without a link and forged
# ?agent_cart= params are rejected on /shop.
# AGENT_CART_SECRET=change-me-32-chars-minimum-secret
# Global daily turn cap across ALL visitors (credit-burn ceiling against
# distributed spam; per-IP limit stays 20/min). Exceeding it returns 503
# until the 24h window resets.
# DEEPSEEK_DAILY_LIMIT=2000
# Optional API base override (any OpenAI-compatible provider). Defaults to
# https://api.deepseek.com — only set to switch provider or for local
# mock/gateway testing. Example for OpenRouter (key from https://openrouter.ai):
#   DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1
#   DEEPSEEK_API_KEY=sk-or-...
#   DEEPSEEK_MODEL=anthropic/claude-sonnet-4   (any model id with tool-calling
#     support; without it the assistant answers from provided data only)
# Optional OpenRouter analytics headers:
# OPENROUTER_HTTP_REFERER=https://melio.vn
# OPENROUTER_X_TITLE=Melio Bookstore
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Multi-instance scaling (Group 2) ────────────────────────────────────────
# Read replica for hot read paths (storefront catalog, dashboard, analytics,
# browse/search). Unset → those reads fall back to the primary automatically.
# READ_REPLICA_URL=postgresql://bookstore:change-me@replica-host:5432/bookstore
# DB_POOL_MAX_READ=10

# In-process job scheduler (instrumentation.ts). Default: runs only on the first
# PM2 cluster worker (NODE_APP_INSTANCE=0); single-node deploys always run it.
# "false" = never schedule here — set this on the web cluster when running the
# dedicated worker (scripts/worker.ts via ecosystem.config.js "bookstore-worker").
# JOB_SCHEDULER_ENABLED=

# Dedicated worker tuning (scripts/worker.ts + lib/jobs.ts). Defaults in code.
# JOB_TICK_MS=300000        # scheduler tick interval
# JOB_LEASE_MS=300000       # dead-worker takeover window (heartbeat renews healthy runs)

# DB circuit breaker (lib/db.ts): fail fast with 503 instead of queueing every
# request behind the 5s connect timeout when Postgres is down. Defaults in code.
# DB_BREAKER_FAILURES=5
# DB_BREAKER_COOLDOWN_MS=30000

# WAL archiving for point-in-time recovery (scripts/ops/wal-archive.sh).
# WAL_SPOOL_DIR=/var/lib/bookstore/wal
# RCLONE_REMOTE=s3:bookstore-backups

# Local/CI seed only. Never seed demo users into production.
SEED_USER_PASSWORD=

# Business timezone for reporting windows (dashboard/analytics day/month bounds).
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Set true ONLY behind a reverse proxy that overwrites X-Forwarded-For
# (nginx/Cloudflare/ALB). See docs/OPERATIONS.md "Reverse-proxy contract".

# ── Logistics carriers (R1: GHTK / ViettelPost) ─────────────────────────────
# Unset → book_carrier refuses loudly; staff keep typing tracking numbers by
# hand (MANUAL). Callback URL for both providers:
# https://<host>/api/carriers/webhook  (body: { secret, provider, trackingNumber, status })
#GHTK_TOKEN=
#GHTK_SHOP_ID=
#VTP_USERNAME=
#VTP_PASSWORD=
#CARRIER_WEBHOOK_SECRET=change-me-to-a-long-random-string

# ── VNPay sandbox checkout ──────────────────────────────────────────────────
# Register at https://sandbox.vnpayment.vn/devreg. Unset → storefront checkout
# rejects paymentMethod=VNPAY; COD flow unaffected.
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_RETURN_URL=http://localhost:3000/api/payments/vnpay/return
VNP_IPN_URL=http://localhost:3000/api/payments/vnpay/ipn

# ── MoMo wallet checkout ────────────────────────────────────────────────────
# Unset → checkout rejects paymentMethod=MOMO; COD/VNPay unaffected.
#MOMO_PARTNER_CODE=
#MOMO_ACCESS_KEY=
#MOMO_SECRET_KEY=
#MOMO_RETURN_URL=http://localhost:3000/api/payments/momo/return
#MOMO_IPN_URL=http://localhost:3000/api/payments/momo/ipn

# ── ZaloPay checkout ────────────────────────────────────────────────────────
# Two MAC keys from onboarding (key1 = create, key2 = IPN verify).
# Unset → checkout rejects paymentMethod=ZALOPAY.
#ZALOPAY_APP_ID=
#ZALOPAY_KEY1=
#ZALOPAY_KEY2=
#ZALOPAY_RETURN_URL=http://localhost:3000/api/payments/zalopay/return
#ZALOPAY_IPN_URL=http://localhost:3000/api/payments/zalopay/ipn

# ── SMTP mail (password reset) ───────────────────────────────────────────────
# Unset → password-reset links are logged server-side instead of emailed
# (dev fallback). Production MUST configure these.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Melio Bookstore <no-reply@melio.vn>"

# ── Error tracking ───────────────────────────────────────────────────────────
# Either, both or neither. Unset → structured JSON logs only (stdout/PM2).
# SENTRY_DSN: minimal Envelope API sender (no @sentry/node dependency).
# ERROR_WEBHOOK_URL: Slack/Discord/Telegram-style incoming webhook POST.
# Both are fire-and-forget, deduped (5 min per fingerprint) and throttled
# (30 events/min) so a crash loop can't burn quota or flood a channel.
SENTRY_DSN=
ERROR_WEBHOOK_URL=

# ── Retention pruning (nightly jobs) ─────────────────────────────────────────
# AuditLog rows older than the window are deleted; WebhookDelivery keeps
# undelivered rows (retry queue) and prunes DELIVERED ones only.
AUDIT_LOG_RETENTION_DAYS=90
WEBHOOK_DELIVERY_RETENTION_DAYS=30
# InventoryMovement partitions older than this many months are DETACHED
# (data preserved as standalone tables — re-attachable), not dropped.
INVENTORY_PARTITION_RETENTION_MONTHS=18

# ── Checkout concurrency semaphore ──────────────────────────────────────────
# Shared across ALL app instances when REDIS_URL is set (sorted-set lease);
# otherwise enforced per-process only (multi-worker deployments over-admit).
MAX_CONCURRENT_CHECKOUTS=20
CHECKOUT_QUEUE_WAIT_MS=5000
# Redis lease lifetime — must exceed the slowest checkout incl. gateway calls.
CHECKOUT_LEASE_MS=120000
# Fuzzy (trigram) catalog search runs under this statement timeout; on
# timeout the tier returns nothing and the exact-match result stands.
FUZZY_SEARCH_TIMEOUT_MS=300

# ── MISA accounting export (nightly job) ─────────────────────────────────────
# The job builds per-org zips into var/misa/ and keeps MISA_RETENTION_DAYS.
# Push to the accountant's server is a manual scp/sftp copy — no ssh2
# dependency by design (repo has zero child_process usage). Example:
#   scp var/misa/misa_<org>_<date>.zip accountant@host:/incoming/
# Set MISA_SFTP_HOST only as a marker that push is expected; the job logs
# a skip-hint (not a failure) until an SLA needs real automated push.
#MISA_SFTP_HOST=
MISA_RETENTION_DAYS=90

# ── Replenishment auto-approve (P4-1) ────────────────────────────────────────
# Threshold lives in SystemConfig key `replenishment.autoApproveUnder`
# (default 2000000 VND) — set via admin API/DB, not env. Suggestion
# accepts at or under the estimate apply immediately; transfers (no
# purchase) always qualify; over-threshold stays PENDING for review.
